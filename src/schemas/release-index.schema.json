{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,"required":["schemaVersion","status","releases"],
  "properties":{
    "schemaVersion":{"const":"1.0"},
    "status":{"enum":["available","comingSoon"]},
    "releases":{"type":"array","items":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"}}
  }
}