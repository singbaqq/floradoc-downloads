{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","version","tag","channel","releaseDate","releaseNotes","requirements","installation","assets","checksumsUrl"],
  "properties":{
    "schemaVersion":{"const":"1.0"},
    "version":{"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
    "tag":{"type":"string","pattern":"^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
    "channel":{"enum":["stable","preview"]},
    "releaseDate":{"type":"string","format":"date"},
    "releaseNotes":{"type":"object","additionalProperties":false,"required":["zh-CN","en"],"properties":{"zh-CN":{"type":"array","minItems":1,"items":{"type":"string","minLength":2}},"en":{"type":"array","minItems":1,"items":{"type":"string","minLength":2}}}},
    "requirements":{"type":"object","additionalProperties":false,"required":["zh-CN","en"],"properties":{"zh-CN":{"type":"array","minItems":1,"items":{"type":"string","minLength":2}},"en":{"type":"array","minItems":1,"items":{"type":"string","minLength":2}}}},
    "installation":{"type":"object","additionalProperties":false,"required":["zh-CN","en"],"properties":{"zh-CN":{"type":"array","minItems":1,"items":{"type":"string","minLength":2}},"en":{"type":"array","minItems":1,"items":{"type":"string","minLength":2}}}},
    "assets":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/asset"}},
    "checksumsUrl":{"type":["string","null"],"format":"uri","pattern":"^https://"}
  },
  "$defs":{"asset":{
    "type":"object","additionalProperties":false,
    "required":["name","platform","architecture","format","fileName","downloadUrl","fileSize","sha256"],
    "properties":{
      "name":{"type":"string","minLength":3},
      "platform":{"enum":["windows","macos","linux"]},
      "architecture":{"enum":["x64","arm64"]},
      "format":{"enum":["installer","zip","dmg","tar.gz"]},
      "fileName":{"type":"string","pattern":"^[A-Za-z0-9._-]+$"},
      "downloadUrl":{"type":"string","format":"uri","pattern":"^https://"},
      "fileSize":{"type":"integer","minimum":1},
      "sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}
    }
  }}
}
